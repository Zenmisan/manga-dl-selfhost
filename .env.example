# ── Required ──────────────────────────────────────────────────────────────────
# Secret key to protect your API. Set this to anything — all requests must
# include X-API-Key: <value> header (or ?api_key=<value> query param).
# Leave empty to run in open mode (no auth — only for trusted networks).
API_KEY=change-me

# ── Storage ───────────────────────────────────────────────────────────────────
# Where manga files are downloaded on the server.
LIBRARY_PATH=/data/manga-library

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default) — no setup needed.
DATABASE_URL=sqlite+aiosqlite:////data/manga_dl.db

# PostgreSQL (optional, for multi-user or persistent cloud deploys):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/manga_dl

# ── Tracker sync (optional) ───────────────────────────────────────────────────
# Create an AniList app at https://anilist.co/settings/developer
# Redirect URI must be: http://your-host/api/auth/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Create a MAL app at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# ── Advanced ──────────────────────────────────────────────────────────────────
# Number of chapters that can download at the same time.
MAX_CONCURRENT_DOWNLOADS=3

# Delay between requests to the same source (seconds).
REQUEST_DELAY=1.0

# Allowed origins for the frontend (comma-separated or JSON array).
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
